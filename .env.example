# Active profile
SPRING_PROFILES_ACTIVE=local

# Database
DB_URL=jdbc:postgresql://localhost:5432/ossdoc_db
DB_USER=postgres
DB_PW=

# Build tools
MAVEN_COMMAND=C:\\path\\to\\mvn.cmd
GRADLE_COMMAND=gradle
JAVA11_HOME=C:\\path\\to\\jdk-11
JAVA17_HOME=C:\\path\\to\\jdk-17
JAVA21_HOME=C:\\path\\to\\jdk-21
JAVA25_HOME=C:\\path\\to\\jdk-25
GRADLE_NO_DAEMON=false
GRADLE_USER_HOME_DIR=.gradle-home
MAVEN_LOCAL_REPO_DIR=.m2/repository

# Workspace and frontend
OSSDOC_WORKSPACE_BASE_DIR=C:/data/ossdoc
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_SUCCESS_REDIRECT_URI=http://localhost:5173/login/success
FRONTEND_FAILURE_REDIRECT_URI=http://localhost:5173/login/failure

# Authentication
ACCESS_COOKIE_NAME=ossdoc_access_token
REFRESH_COOKIE_NAME=ossdoc_refresh_token
AUTH_SECURE_COOKIE=false
AUTH_COOKIE_SAME_SITE=Lax
JWT_ISSUER=ossdoc
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=1209600000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ACCOUNT_REJOIN_WAIT_DAYS=30

# Claude API (optional when using Ollama)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_HAIKU_MODEL=claude-haiku-4-5
CLAUDE_HAIKU_FALLBACK_ENABLED=false
CLAUDE_MAX_TOKENS=20000

# Ollama
LLM_ENABLED=true
LLM_PROVIDER=ollama
LLM_OUTPUT_LOCAL_ONLY=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=6500
OLLAMA_TEMPERATURE=0.2
OLLAMA_SEED=0
OLLAMA_TIMEOUT_MINUTES=360
OLLAMA_JSON_FORMAT=true
OLLAMA_THINK=false
LLM_MAX_CAUTIONS=20
LLM_MAX_SCENARIOS=6
LLM_MAX_STEPS_PER_SCENARIO=6
LLM_TOKENS_CAUTIONS=6500
LLM_TOKENS_SCENARIOS=5000
LLM_SCENARIO_CALL_MODE=per-scenario
LLM_TOKENS_SCENARIO_BASE=400
LLM_TOKENS_SCENARIO_PER_STEP=350
LLM_TOKENS_OVERVIEW=900
LLM_REUSE_CAUTIONS=false
LLM_INPUT_SUPER_CLUSTER_ENABLED=true
LLM_INPUT_API_FLOW_ENABLED=true

# Redis and analysis cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
OSSDOC_CACHE_REDIS_ENABLED=true
OSSDOC_CACHE_PIPELINE_CONTRACT_VERSION=pipeline-v1
OSSDOC_CACHE_LLM_PROFILE_VERSION=llm-profile-sonnet-v2
OSSDOC_CACHE_PROMPT_TEMPLATE_VERSION=prompt-v2
OSSDOC_CACHE_OUTPUT_SCHEMA_VERSION=schema-v2
OSSDOC_CACHE_DEFAULT_RUN_OPTIONS_SIGNATURE=options-default-v1
OSSDOC_CACHE_REDIS_READY_KEY_PREFIX=analysis:ready
OSSDOC_CACHE_REDIS_LOCK_KEY_PREFIX=analysis:lock
OSSDOC_CACHE_REDIS_READY_TTL_HOURS=24
OSSDOC_CACHE_REDIS_LOCK_TTL_MINUTES=20
OSSDOC_CACHE_FAILED_COOLDOWN_SECONDS=30
PIPELINE_WORKER_FIXED_DELAY_MS=2000
PIPELINE_WORKER_MAX_JOBS_PER_TICK=1
PIPELINE_WORKER_LOCK_RENEW_INTERVAL_MS=600000

# Cluster and API-flow analysis
CLUSTER_SIGNAL_PACKAGE_ENABLED=true
CLUSTER_SIGNAL_NAME_ENABLED=true
CLUSTER_SIGNAL_DOC_ENABLED=true
CLUSTER_SIGNAL_API_FLOW_ENABLED=true
CLUSTER_SUPER_CLUSTER_ENABLED=true
OSSDOC_API_FLOW_MAX_ENTRY_POINTS=50

# AWS and artifact storage
AWS_REGION=ap-northeast-2
S3_BUCKET=ossdoc-artifact-storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GitHub statistics
GITHUB_STATS_TOKEN=
GITHUB_STATS_CACHE_TTL_MINUTES=360
GITHUB_STATS_API_TIMEOUT_SECONDS=30

# PortOne
PORTONE_ENV=test
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_API_BASE_URL=https://api.portone.io
MEMBERSHIP_PAYMENT_PROVIDER=PORTONE_V2
